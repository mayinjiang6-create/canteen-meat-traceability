# 复制为 .env 后按现场情况修改：cp .env.example .env
# .env 已在 .gitignore 中（口令与密钥绝不进仓库）

# ---------- 端口（客户现场被占用时改这三个）----------
FRONTEND_PORT=8088
BACKEND_PORT=8080
MYSQL_PORT=3306

# ---------- 数据库口令 ----------
MYSQL_ROOT_PASSWORD=Root@Meat2026
DB_USER=meat
DB_PASSWORD=Meat@2026

# ---------- 令牌签名（HS256，至少 32 字节，交付前必须改成随机值）----------
JWT_SECRET=meat-trace-demo-secret-please-override-in-env-2026

# ---------- 前端构建源（国内现场建议用镜像源加速）----------
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 链：可选外部依赖 ----------
# 不接链时把 EVIDENCE_WORKER_ENABLED 设为 false，其余留空即可
EVIDENCE_WORKER_ENABLED=false
WEBASE_BASE_URL=http://192.168.239.130:5002/WeBASE-Front
CHAIN_RPC_URL=http://192.168.239.130:8545
CONTRACT_ADDRESS=0xd24180cc0fef2f3e545de4f9aafc09345cd08903
